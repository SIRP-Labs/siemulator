# Auth tokens — defaults are public sentinels. Override in production.
SIEMULATOR_LOGSCALE_TOKEN=logscale-dev-token
SIEMULATOR_QRADAR_TOKEN=qradar-dev-token

# Admin key for /qradar/_debug/* endpoints (request capture, scenario state).
# Leave blank to disable debug endpoints entirely.
SIEMULATOR_ADMIN_KEY=

# URL prefix overrides. Defaults are vendor-neutral (/logscale, /qradar).
# Set to /omnisense if you're migrating from sara-open's mock routes.
SIEMULATOR_LOGSCALE_PREFIX=/logscale
SIEMULATOR_QRADAR_PREFIX=/qradar

# Bind address for `python -m siemulator`
SIEMULATOR_HOST=0.0.0.0
SIEMULATOR_PORT=8080

# Web UI at /. Default on. Set to `false` for pure-API mode where
# / returns JSON metadata (the same payload as /api/info).
SIEMULATOR_UI_ENABLED=true

# Access log — captures every request to /logscale/* and /qradar/* into
# a bounded in-memory ring AND emits a structured JSON line to stdout
# (uvicorn forwards to the platform log surface). Token values are
# never recorded — only the auth channel name. Admin endpoints:
#   GET  /api/access-log         — recent entries with filters
#   GET  /api/access-log/stats   — aggregations
#   POST /api/access-log/clear   — wipe the in-memory ring
# All three require SIEMULATOR_ADMIN_KEY to be set + sent on the request.
SIEMULATOR_ACCESS_LOG_ENABLED=true
SIEMULATOR_ACCESS_LOG_SIZE=5000          # ring capacity; oldest evicted
SIEMULATOR_ACCESS_LOG_SKIP_HEALTH=false  # set true to skip /status etc.
